# Ask4Me: multi-user trial + optional E2EE
#
# 复制为 .env 后，至少改这两项：
#   ASK4ME_BASE_URL         -> 你的 https 域名（E2EE 必须 https）
#   ASK4ME_MULTI_USER_INVITE_CODES -> 你自己的邀请码
#
# 多用户模式下 ASK4ME_API_KEY 会被忽略，保持空即可。

ASK4ME_BASE_URL=https://ask.example.com
ASK4ME_LISTEN_ADDR=:8080
ASK4ME_SQLITE_PATH=/data/ask4me2.db
TZ=Asia/Shanghai

# ---- Multi-user: every API key is a tenant ----
ASK4ME_MULTI_USER_ENABLED=true
ASK4ME_MULTI_USER_MODE=open
ASK4ME_MULTI_USER_INVITE_CODES=trial-2026
ASK4ME_MULTI_USER_REQUESTS_PER_DAY=200
ASK4ME_MULTI_USER_MAX_PENDING=5
ASK4ME_MULTI_USER_MAX_EXPIRES_IN_SECONDS=86400
ASK4ME_MULTI_USER_PER_IP_REQUESTS_PER_HOUR=60
ASK4ME_MULTI_USER_PER_IP_NEW_KEYS_PER_DAY=10
ASK4ME_MULTI_USER_GLOBAL_REQUESTS_PER_DAY=5000

# 仅在 Caddy/Nginx 等反代正确覆盖 X-Forwarded-For 时开；直连改成 false。
ASK4ME_MULTI_USER_TRUST_PROXY=true

# 多用户下这个值不生效；留空，避免误以为它是全局 key。
ASK4ME_API_KEY=

# ---- E2EE: allowed, but per-request opt-in ----
# true 只是允许用户使用，不会强制；不带 e2ee 的请求仍按明文工作。
# 必须配合 https 的 ASK4ME_BASE_URL，否则服务会启动失败。
ASK4ME_E2EE_ENABLED=true
ASK4ME_E2EE_KDF_ITERATIONS=310000
ASK4ME_E2EE_ENCRYPT_ANSWERS_DEFAULT=true

# ---- Tuning ----
ASK4ME_DEFAULT_EXPIRES_IN_SECONDS=3600
ASK4ME_SSE_HEARTBEAT_INTERVAL_SECONDS=15
ASK4ME_TERMINAL_CACHE_SECONDS=60

# 多用户下全局通知渠道不生效；每个请求必须带 notify。
# 单用户才需要下面两项：
# ASK4ME_SERVERCHAN_SENDKEY=
# ASK4ME_APPRISE_URLS=

# 如果你想改成白名单，而不是邀请码自助：
# ASK4ME_MULTI_USER_MODE=allowlist
# ASK4ME_MULTI_USER_KEYS=key1,key2
