ASK4ME_BASE_URL=http://dd.ftqq.com:8080
ASK4ME_API_KEY=change-me
ASK4ME_SERVERCHAN_SENDKEY=sctp...
ASK4ME_APPRISE_URLS=schan://SCT1...
ASK4ME_APPRISE_BIN=apprise
ASK4ME_SQLITE_PATH=./ask4me.db
ASK4ME_DEFAULT_EXPIRES_IN_SECONDS=3600
ASK4ME_SSE_HEARTBEAT_INTERVAL_SECONDS=15
ASK4ME_LISTEN_ADDR=:8080
ASK4ME_TERMINAL_CACHE_SECONDS=60

# Multi-user / trial mode (off by default).
# When enabled, ASK4ME_API_KEY is ignored; put keys in ASK4ME_MULTI_USER_KEYS.
# ASK4ME_MULTI_USER_ENABLED=true
# ASK4ME_MULTI_USER_MODE=allowlist
# ASK4ME_MULTI_USER_KEYS=a4m_key_one,a4m_key_two
# ASK4ME_MULTI_USER_INVITE_CODES=trial2026
# ASK4ME_MULTI_USER_REQUESTS_PER_DAY=200
# ASK4ME_MULTI_USER_MAX_PENDING=5
# ASK4ME_MULTI_USER_MAX_EXPIRES_IN_SECONDS=86400
# ASK4ME_MULTI_USER_PER_IP_REQUESTS_PER_HOUR=60
# ASK4ME_MULTI_USER_PER_IP_NEW_KEYS_PER_DAY=10
# ASK4ME_MULTI_USER_GLOBAL_REQUESTS_PER_DAY=5000
# ASK4ME_MULTI_USER_TRUST_PROXY=false
# ASK4ME_ALLOWED_APPRISE_SCHEMES=schan,tgram,discord,slack,ntfy,gotify
